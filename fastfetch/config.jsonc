{
  "logo": {
    "source": "$HOME/.config/fastfetch/logo.txt",
    "width": 20,
    "color": {
      "1": "black",
      "2": "red",
      "3": "green",
      "4": "yellow",
      "5": "blue",
      "6": "magenta",
      "7": "cyan",
      "8": "white"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    {
      "type": "os",
      "format": "arch linux x86_64",
      "key": "os    ",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "format": "linux zen {release}",
      "key": "kernel",
      "keyColor": "32"
    },
    {
      "type": "terminal",
      "key": "term  ",
      "keyColor": "33"
    },
    {
      "type": "shell",
      "key": "shell ",
      "keyColor": "34"
    },
    {
      "type": "packages",
      "format": "{all} (pacman)",
      "key": "pkgs  ",
      "keyColor": "35"
    },
    {
      "type": "uptime",
      "format": "{2}h {3}m",
      "key": "uptime",
      "keyColor": "36"
    },
    {
      "type": "memory",
      "format": "{used} ({percentage})",
      "key": "memory",
      "keyColor": "37"
    },
    {
      "type": "disk",
      "format": "{size-used} ({size-percentage})",
      "key": "disk  ",
      "keyColor": "37"
    },
    {
      "type": "battery",
      "key": "bat   ",
      "keyColor": "37"
    },
    "break",
    "colors"
  ]
}
