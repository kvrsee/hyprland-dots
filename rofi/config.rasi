configuration {
  display-drun: "";
  display-window: "";
  drun-display-format: "{icon} {name}";
  font: "JetBrainsMono Nerd Font Mono 14";
  modi: "window,run,drun";
  show-icons: true;
  icon-theme: "Papirus";
}

@theme "/dev/null"

* {
  bg: #1E1E2E;
  bg-alt: #a6e3a1;

  fg: #cdd6f4;
  fg-alt: #11111b;

  background-color: @bg;

  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 30%;
  border: 20px;
  border-color: @bg;
}

element {
  padding: 12;
  text-color: @fg;
}

element selected {
  text-color: @fg-alt;
  background-color: @bg-alt;
}

  element-text {
  background-color: inherit;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  size: 40;
  background-color: @bg;
}

element-icon selected {
  size: 40;
  background-color: @bg-alt;
}

entry {
  placeholder: "  search";
  placeholder-color: #6c7086;
  background-color: #313244;
  padding: 12;
  text-color: @fg;
  border: 0px 0px 20px 0px;
  border-color: @bg;
}

inputbar {
  children: [prompt, entry];
}

listview {
  background-color: @bg;
  colums: 1;
  lines: 8;
}

mainbox {
  background-color: @bg;
  children: [inputbar, listview];
}

